# Primary AI provider: openai | qwen | deepseek | bytecat
AI_PROVIDER=openai
AI_FALLBACK_PROVIDER=qwen
AI_REQUIRE_REAL=true

# OpenAI GPT. Use this for higher quality MVP testing.
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# Alibaba Cloud Model Studio / Bailian Qwen-VL fallback for image understanding and text generation.
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen-vl-plus

# ByteCat: GPT uses chat/completions; Gemini uses its own generateContent endpoint.
# AI_PROVIDER=bytecat
BYTECAT_API_KEY=sk-your-bytecat-api-key
BYTECAT_BASE_URL=https://www.bytecatcode.org/v1
BYTECAT_MODEL=gpt-5.6-luna
BYTECAT_VISION_MODEL=gpt-5.6-terra
BYTECAT_GEMINI_BASE_URL=https://bytecat.lamclod.cn
BYTECAT_GEMINI_API_KEY=sk-your-bytecat-gemini-api-key
BYTECAT_TEXT_FALLBACK_MODELS=gemini-3.7-flash,gemini-3-flash-preview,gpt-5.5,gpt-5.6-sol
BYTECAT_VISION_FALLBACK_MODELS=gemini-3.7-flash,gemini-3-flash-preview,gpt-5.6-sol,gpt-5.5
# Try a backup after the primary model exceeds this deadline (including response body).
BYTECAT_PRIMARY_TIMEOUT_MS=8000
BYTECAT_TEXT_TIMEOUT_MS=18000
BYTECAT_VISION_TIMEOUT_MS=22000

# Supabase persistence. VITE_* values are public and baked into the browser bundle.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key

# Server-only Supabase values. Keep real values in .env.local / Worker secrets only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key
SUPABASE_SECRET_KEY=sb_secret_your-secret-key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SEND_SMS_HOOK_SECRETS=v1,your-supabase-send-sms-hook-secret

# Mainland SMS hook currently sends through Alibaba Cloud PNVS.
# Keep these server-only. If we switch to Volcengine SMS later, add a provider adapter instead of exposing keys to clients.
ALIYUN_SMS_ACCESS_KEY_ID=your-aliyun-access-key-id
ALIYUN_SMS_ACCESS_KEY_SECRET=your-aliyun-access-key-secret
ALIYUN_SMS_SIGN_NAME=NEKOID
ALIYUN_SMS_TEMPLATE_CODE=SMS_123456789
ALIYUN_SMS_REGION_ID=cn-hangzhou
ALIYUN_SMS_COUNTRY_CODE=86
ALIYUN_SMS_CODE_PARAM_KEY=code
ALIYUN_SMS_MIN_PARAM_KEY=min
ALIYUN_SMS_VALID_MINUTES=5

# Use DeepSeek for text generation. DeepSeek API is text-only here, so image/video validation is relaxed.
# AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash
