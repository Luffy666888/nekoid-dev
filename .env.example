# Primary AI provider: openai | qwen | deepseek | bytecat
AI_PROVIDER=openai
AI_FALLBACK_PROVIDER=qwen
AI_REQUIRE_REAL=true

# OpenAI GPT. Use this for higher quality MVP testing.
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# Alibaba Cloud Model Studio / Bailian Qwen-VL fallback for image understanding and text generation.
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen-vl-plus

# ByteCat OpenAI-compatible endpoint. Use luna for pure text and terra for multimodal.
# AI_PROVIDER=bytecat
BYTECAT_API_KEY=sk-your-bytecat-api-key
BYTECAT_BASE_URL=https://www.bytecatcode.org/v1
BYTECAT_MODEL=gpt-5.6-luna
BYTECAT_VISION_MODEL=gpt-5.6-terra

# Use DeepSeek for text generation. DeepSeek API is text-only here, so image/video validation is relaxed.
# AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash
