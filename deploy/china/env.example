NODE_ENV=production
HOST=0.0.0.0
PORT=3000

AI_PROVIDER=bytecat
AI_FALLBACK_PROVIDER=
AI_REQUIRE_REAL=true

BYTECAT_API_KEY=sk-your-bytecat-api-key
BYTECAT_BASE_URL=https://www.bytecatcode.org/v1
BYTECAT_GEMINI_BASE_URL=https://bytecat.lamclod.cn
# Dedicated token for the Gemini endpoint. Keep the real value server-only.
BYTECAT_GEMINI_API_KEY=sk-your-bytecat-gemini-api-key
BYTECAT_MODEL=gemini-3.7-flash
BYTECAT_VISION_MODEL=gemini-3.7-flash
BYTECAT_CATFACE_MODEL=gemini-3.7-flash
BYTECAT_CATFACE_FALLBACK_MODELS=
BYTECAT_TEXT_FALLBACK_MODELS=
BYTECAT_VISION_FALLBACK_MODELS=
BYTECAT_CATFACE_TIMEOUT_MS=15000
BYTECAT_PRIMARY_TIMEOUT_MS=30000
BYTECAT_TEXT_TIMEOUT_MS=30000
BYTECAT_VISION_TIMEOUT_MS=30000

DASHSCOPE_API_KEY=sk-your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen-vl-plus

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key
SUPABASE_SECRET_KEY=sb_secret_your-secret-key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SEND_SMS_HOOK_SECRETS=v1,your-supabase-send-sms-hook-secret

ALIYUN_SMS_ACCESS_KEY_ID=your-aliyun-access-key-id
ALIYUN_SMS_ACCESS_KEY_SECRET=your-aliyun-access-key-secret
ALIYUN_SMS_SIGN_NAME=NEKOID
ALIYUN_SMS_TEMPLATE_CODE=SMS_123456789
ALIYUN_SMS_REGION_ID=cn-hangzhou
ALIYUN_SMS_COUNTRY_CODE=86
ALIYUN_SMS_CODE_PARAM_KEY=code
ALIYUN_SMS_MIN_PARAM_KEY=min
ALIYUN_SMS_VALID_MINUTES=5
